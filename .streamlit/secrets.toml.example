# Copy this file to .streamlit/secrets.toml and fill in your values.
# On Streamlit Cloud, add these as secrets in the app dashboard instead.

[backend]
url = "https://your-backend-url.onrender.com"

[supabase]
SUPABASE_URL     = "https://your-project.supabase.co"
SUPABASE_ANON_KEY = "your-anon-key"

[google_oauth]
redirect_uri = "https://your-streamlit-app.streamlit.app"
